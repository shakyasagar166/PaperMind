# Application Environment (development, production, testing)
APP_ENV=development
PROJECT_NAME="PaperMind"
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="papermind_super_secret_jwt_encryption_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./data/papermind.db"

# LLM Providers (OpenAI, Gemini, etc.)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Storage & Vector Database
STORAGE_DIR="./data"
CHROMA_PERSIST_DIRECTORY="./data/processed/chroma"
